{
  "name": "meowpush-gh-actions",
  "version": "1.0.1",
  "private": true,
  "description": "Send MeowPush notifications from GitHub Actions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "test:fixtures": "node scripts/ci-smoke.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:metadata": "node scripts/check-metadata.js",
    "check:dist": "node scripts/check-dist.js",
    "check": "npm run lint && npm run format:check && npm run check:metadata && npm test && npm run check:dist"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
